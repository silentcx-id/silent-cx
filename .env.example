# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect > Connection String > Session pooler (untuk npm run db:migrate)
SUPABASE_DB_URL=

# Alamat aplikasi (lokal: http://localhost:3000, produksi di .env.prod: https://silentcx.com)
# .env.local = project staging; .env.prod = project produksi (lihat docs/SETUP.md langkah 8)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifikasi lewat Resend dan kunci pemanggil /api/email/dispatch (docs/SETUP.md langkah 8b-2). Boleh kosong di laptop.
RESEND_API_KEY=
EMAIL_DISPATCH_SECRET=
EMAIL_FROM=SilentCX <noreply@silentcx.com>

# Captcha Cloudflare Turnstile (docs/SETUP.md langkah 8b nomor 6). Kosong = captcha tidak dipakai.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
