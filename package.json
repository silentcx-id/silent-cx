{
  "name": "silentcx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint && vitest run",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:migrate:prod": "node --env-file=.env.prod scripts/db-migrate.mjs",
    "demo:akun": "node --env-file=.env.local scripts/demo-accounts.mjs",
    "demo:data": "node --env-file=.env.local scripts/demo-data.mjs",
    "admin:buat": "node --env-file=.env.local scripts/admin-create.mjs",
    "admin:buat:prod": "node --env-file=.env.prod scripts/admin-create.mjs",
    "env:cek": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "env:cek:prod": "node --env-file-if-exists=.env.prod scripts/check-env.mjs",
    "contoh:laporan": "esbuild scripts/sample-report.mts --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=e2e-output/.sample-report.mjs && node e2e-output/.sample-report.mjs",
    "contoh:laporan:shot": "esbuild scripts/sample-report-shot.mts --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=e2e-output/.sample-report-shot.mjs && node e2e-output/.sample-report-shot.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
